# Deployment profile: intranet | airgap | internet-lab (default intranet)
DEPLOY_PROFILE=intranet

# PostgreSQL (compose.intranet.yml)
DATABASE_URL=postgres://agenthub:agenthub@localhost:5432/agenthub

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agenthub
S3_SECRET_KEY=agenthubsecret
S3_BUCKET=agenthub
S3_REGION=us-east-1

# Hub auth (generate strong secrets in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Bootstrap platform admin (P0-02+)
AGENTHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=admin-password-change-me

# Hub API
PORT=8080
PLATFORM_DEK=dev-platform-dek-32bytes-minimum!!
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
# Use in-process mock OpenCode when no external instance (P0 local default)
RUNTIME_MOCK=true

# Hub Shell (Vite)
VITE_HUB_API_BASE=
